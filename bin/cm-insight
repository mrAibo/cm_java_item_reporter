#!/usr/bin/env bash
#
# CM Insight - application launcher.
#
#   ./bin/cm-insight [--help] [application arguments...]
#
# Runs the packaged build/cm-insight.jar with the JDK from JAVA_HOME (or PATH),
# adding any local jars from lib/{ibm,db2,oracle,app} to the class path. No
# network access. Exits with the application's own exit code.
#
# Application home: every RELATIVE operational path in the configuration
# (profiles.dir, classifications.file, secrets.dir, data.dir, reports.dir,
# logs.dir) is resolved against the application home - never against the
# directory this launcher happened to be invoked from. The home is this
# installation's root unless CM_INSIGHT_HOME names another one, and it is passed
# to the JVM both as -Dcminsight.home (the resolver's primary source) and as the
# environment variable CM_INSIGHT_HOME (its secondary source).
#
# Message prefixes: "OK:" informational, "WARN:" non-fatal, "ERROR:" fatal.
# Exit codes: 2 usage/environment problem, otherwise the application's code.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./bin/cm-insight [--help] [application arguments...]

Launches CM Insight (build/cm-insight.jar) after checking the environment.

Environment:
  JAVA_HOME                  JDK 17+ home (accepted as /c/tools/jdk17, C:/tools/jdk17
                             or C:\tools\jdk17); falls back to PATH
  CM_INSIGHT_CONFIG          configuration file (default conf/application.properties).
                             A relative value is resolved against the application home,
                             so systemd units (WorkingDirectory=/) and interactive shells
                             behave identically
  CM_INSIGHT_HOME            application home used for every relative operational path
                             (profiles.dir, classifications.file, secrets.dir, ...).
                             Default: this installation's root, i.e. the directory that
                             contains bin/ and conf/. It is passed to the JVM as
                             -Dcminsight.home and exported as CM_INSIGHT_HOME
  CM_INSIGHT_IBM_LIBS        directory holding the IBM CM 8.7 SDK jars when they are NOT
                             in lib/ibm (a staging directory, a shared mount, a vendor
                             installation). Additive to lib/ibm, so a one-off real-SDK
                             check needs no repository change. A relative value is
                             resolved against the application home. The jars are never
                             committed: they are proprietary
  CM_INSIGHT_REQUIRE_IBM     "true" refuses to launch unless at least one IBM SDK jar is
                             on the class path. Use it when a check is meaningless
                             without the adapter, so a silently core-only run cannot be
                             mistaken for a validated one
  CM_INSIGHT_JAVA_OPTS       extra JVM options, word-split on spaces
                             (e.g. "-Xmx512m -Dfile.encoding=UTF-8"); a
                             -Dcminsight.home here is overridden by the launcher

Common application arguments:
  --config <file>            configuration file
  --validate-config          check credentials and the exposure policy, print the
                             resolved operational paths, then exit
  --check-repository <id>    activate one repository through the production bounded-pool
                             path, report the CM API release, the ItemType count and the
                             retention policy count, shut down through the repository
                             manager, and fail unless that shutdown is terminal-clean.
                             Read-only: it performs no IBM CM write
  --version                  print the version and exit
  --self-test                run the in-process self-test and exit

Build first when build/cm-insight.jar is missing: ./build.sh
USAGE
}

for arg in "$@"; do
  case "${arg}" in
    -h|--help) usage; exit 0 ;;
  esac
done

SELF="${BASH_SOURCE[0]:-$0}"
SCRIPT_DIR="$(dirname -- "${SELF}")"
[ -d "${SCRIPT_DIR}" ] || { printf 'ERROR: cannot locate script directory: %s\n' "${SCRIPT_DIR}" >&2; exit 2; }
ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)" || { printf 'ERROR: cannot resolve repository root from %s\n' "${SCRIPT_DIR}" >&2; exit 2; }

# Class path separator: always ':' - the POSIX separator, correct as-is on the
# real Linux/Unix target. Under Git Bash / MSYS2 the shell layer translates a
# ':'-joined list of ABSOLUTE POSIX paths into the Windows form the native JVM
# expects, whereas a ';'-joined list is passed through untranslated and javac
# then fails with "bad path element". Do NOT "fix" this back to ';': every entry
# below is an absolute path derived from the repository root, which is what keeps
# that translation reliable on Windows and correct on Linux/macOS.
CP_SEP=":"

JH="${JAVA_HOME:-}"
if [ -n "${JH}" ]; then
  case "$(uname -s 2>/dev/null || printf 'unknown')" in
    MINGW*|MSYS*|CYGWIN*)
      case "${JH}" in
        [A-Za-z]:[\\/]*)
          _drive="$(printf '%s' "${JH}" | cut -c1 | tr 'A-Z' 'a-z')"
          _rest="$(printf '%s' "${JH}" | cut -c3- | tr '\\' '/')"
          JH="/${_drive}${_rest}"
          ;;
      esac
      ;;
  esac
  case "${JH}" in */) JH="${JH%/}" ;; esac
  JAVA="${JH}/bin/java"
else
  JAVA="$(command -v java 2>/dev/null || true)"
fi
if [ -z "${JAVA}" ] || [ ! -x "${JAVA}" ]; then
  printf 'ERROR: java not found%s. Install a JDK 17+ and set JAVA_HOME, or put its bin/ directory on PATH.\n' "${JAVA:+ at ${JAVA}}" >&2
  exit 2
fi

APP_JAR="${ROOT}/build/cm-insight.jar"
if [ ! -f "${APP_JAR}" ]; then
  printf 'ERROR: %s not found. Build the application first: ./build.sh\n' "${APP_JAR}" >&2
  exit 2
fi
if [ ! -s "${APP_JAR}" ]; then
  printf 'ERROR: %s is empty or truncated. Re-run ./build.sh\n' "${APP_JAR}" >&2
  exit 2
fi

CP="${APP_JAR}"
for module in ibm db2 oracle app; do
  dir="${ROOT}/lib/${module}"
  [ -d "${dir}" ] || continue
  for jar_file in "${dir}"/*.jar; do
    [ -e "${jar_file}" ] || continue
    CP="${CP}${CP_SEP}${jar_file}"
  done
done

# ---------------------------------------------------------------------------
# Application home (Goal 01A section D).
#
# The home is this installation's root unless the operator names another one.
# It is exported as CM_INSIGHT_HOME and passed to the JVM as -Dcminsight.home,
# which is what makes a relative profiles.dir/classifications.file/secrets.dir
# resolve to the same place no matter where this launcher was started from.
# A relative CM_INSIGHT_HOME is deliberately left relative: it then resolves
# against the working directory in exactly the same way in the shell below and
# in AppPaths.
# ---------------------------------------------------------------------------
APP_HOME="${CM_INSIGHT_HOME:-${ROOT}}"
export CM_INSIGHT_HOME="${APP_HOME}"

CONFIG="${CM_INSIGHT_CONFIG:-${APP_HOME}/conf/application.properties}"
# Same one rule for the shell's own file check: a relative CM_INSIGHT_CONFIG is
# resolved against the application home. Without this, a systemd unit with
# CM_INSIGHT_CONFIG=conf/application.properties would fail here even though the
# JVM below would have resolved it correctly.
case "${CONFIG}" in
  /*|[A-Za-z]:[\\/]*) : ;;
  *) CONFIG="${APP_HOME}/${CONFIG}" ;;
esac
if [ ! -f "${CONFIG}" ]; then
  printf 'ERROR: configuration file not found: %s\n       Create it with: cp conf/application.properties.example conf/application.properties\n' "${CONFIG}" >&2
  exit 2
fi

JAVA_OPTS=()
if [ -n "${CM_INSIGHT_JAVA_OPTS:-}" ]; then
  # Intentional word splitting: CM_INSIGHT_JAVA_OPTS holds a list of JVM options.
  # shellcheck disable=SC2206
  JAVA_OPTS=(${CM_INSIGHT_JAVA_OPTS})
fi

# ---------------------------------------------------------------------------
# External IBM SDK (Goal 02 section A).
#
# The IBM CM SDK jars are proprietary and are never committed to this repository.
# lib/README.md tells an operator to place them in lib/ibm, which the class-path
# loop above already picked up. This adds the second, equally supported case: the
# jars live elsewhere on the host - a staging directory, a shared read-only mount,
# a vendor installation - and CM_INSIGHT_IBM_LIBS names that directory.
#
# The two are additive on purpose: a host can carry a routine SDK in lib/ibm and
# point at a different build for a one-off check without editing the repository,
# which is exactly what a real-SDK validation run needs. It sits AFTER the
# application-home block because a relative value is resolved against the home.
#
# The jar count is reported, never assumed. "The class path carries the SDK" and
# "the adapter is available" are different statements and only the second is
# evidence: the application reports true availability through its own provider
# discovery, and this line only says what was put in front of the JVM.
# ---------------------------------------------------------------------------
IBM_JAR_COUNT=0
for jar_file in "${ROOT}"/lib/ibm/*.jar; do
  [ -e "${jar_file}" ] || continue
  IBM_JAR_COUNT=$((IBM_JAR_COUNT + 1))
done

EXTERNAL_IBM_DIR="${CM_INSIGHT_IBM_LIBS:-}"
if [ -n "${EXTERNAL_IBM_DIR}" ]; then
  case "${EXTERNAL_IBM_DIR}" in
    /*|[A-Za-z]:[\\/]*) : ;;
    *) EXTERNAL_IBM_DIR="${APP_HOME}/${EXTERNAL_IBM_DIR}" ;;
  esac
  if [ ! -d "${EXTERNAL_IBM_DIR}" ]; then
    printf 'ERROR: CM_INSIGHT_IBM_LIBS is set to %s but that is not a directory.\n' "${EXTERNAL_IBM_DIR}" >&2
    exit 2
  fi
  for jar_file in "${EXTERNAL_IBM_DIR}"/*.jar; do
    [ -e "${jar_file}" ] || continue
    CP="${CP}${CP_SEP}${jar_file}"
    IBM_JAR_COUNT=$((IBM_JAR_COUNT + 1))
  done
fi

if [ "${IBM_JAR_COUNT}" -gt 0 ]; then
  printf 'OK: IBM SDK jars on the class path: %s\n' "${IBM_JAR_COUNT}"
else
  # Not an error: core-only mode is supported and repository profiles are still
  # listed. Reported because an operator who expected the adapter needs to see why
  # activation will refuse.
  printf 'WARN: no IBM SDK jar on the class path (lib/ibm is empty and CM_INSIGHT_IBM_LIBS is unset); the IBM adapter will report itself unavailable.\n'
fi

if [ "${CM_INSIGHT_REQUIRE_IBM:-false}" = "true" ] && [ "${IBM_JAR_COUNT}" -eq 0 ]; then
  printf 'ERROR: CM_INSIGHT_REQUIRE_IBM=true but no IBM SDK jar is on the class path. Place the IBM CM 8.7 SDK jars in lib/ibm, or set CM_INSIGHT_IBM_LIBS to the directory that holds them; see lib/README.md.\n' >&2
  exit 2
fi

# -Dcminsight.home comes after CM_INSIGHT_JAVA_OPTS on purpose: the launcher, not a
# stray option in the environment, decides where the application home is.
exec "${JAVA}" ${JAVA_OPTS[@]+"${JAVA_OPTS[@]}"} \
  -Dcminsight.home="${APP_HOME}" \
  -cp "${CP}" com.mraibo.cminsight.app.Main --config "${CONFIG}" "$@"
